APP_NAME=CopyCabana
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://copycabana.test

APP_LOCALE=pl
APP_FALLBACK_LOCALE=pl
APP_FAKER_LOCALE=pl_PL
PRIVACY_POLICY_VERSION=2026-01
PRIVACY_CLIENT_RETENTION_DAYS=365
PRIVACY_AUDIT_RETENTION_DAYS=365
PRIVACY_CONSENT_RETENTION_DAYS=1095

# Production should contain only the canonical hostnames, as regex patterns.
# APP_TRUSTED_HOSTS=^copycabana\.pl$,^www\.copycabana\.pl$

# Set these only when running the seeder to provision an initial admin account.
# ADMIN_EMAIL=admin@copycabana.pl
# ADMIN_PASSWORD=change-this-password
# ADMIN_NAME=CopyCabana Admin

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

BUSINESS_CURRENCY=PLN
BUSINESS_TAX_RATE=23
BUSINESS_QUOTE_EMAIL=biuro@copycabana.pl
SHIPPING_PICKUP=0
SHIPPING_PARCEL=12
SHIPPING_COURIER=18
THESIS_PAGE_PRICE_BW=0.20
THESIS_PAGE_PRICE_COLOR=0.50

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# Production Forge:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=copycabana
# DB_USERNAME=copycabana
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# Production Forge: CACHE_STORE=redis
# CACHE_PREFIX=copycabana-cache-

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
# Production Brevo SMTP:
# MAIL_MAILER=smtp
# MAIL_SCHEME=tls
# MAIL_HOST=smtp-relay.brevo.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_TIMEOUT=10
# MAIL_FROM_ADDRESS="biuro@copycabana.pl"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

INPOST_API_BASE_URL=https://api-pl-points.easypack24.net/v1
# INPOST_API_TOKEN=

PAYMENT_PROVIDER=payu
PAYU_BASE_URL=https://secure.snd.payu.com
# PAYU_POS_ID=
# PAYU_CLIENT_ID=
# PAYU_CLIENT_SECRET=
# PAYU_SECOND_KEY=

# Production Forge overrides:
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://copycabana.pl
# SESSION_DRIVER=redis
# SESSION_SECURE_COOKIE=true
# QUEUE_CONNECTION=redis
# CACHE_STORE=redis
# FILESYSTEM_THROW=true
# PAYU_BASE_URL=https://secure.payu.com
